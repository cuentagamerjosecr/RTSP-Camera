<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RTSP CAMERA"
            android:textColor="#102A43"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Convierte este teléfono en una cámara IP"
            android:textColor="#52606D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E1EAF2"
            android:padding="14dp"
            android:text="Estado: detenido"
            android:textColor="#102A43"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="INICIAR TRANSMISIÓN"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="DIRECCIÓN RTSP"
            android:textColor="#52606D"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/urlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="rtsp://IP-DEL-TELEFONO:8554/live"
            android:textColor="#102A43"
            android:textIsSelectable="true"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="COPIAR DIRECCIÓN" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="CONFIGURACIÓN DE VIDEO"
            android:textColor="#102A43"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Resolución"
            android:textColor="#52606D" />
        <Spinner
            android:id="@+id/resolutionSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="FPS"
            android:textColor="#52606D" />
        <Spinner
            android:id="@+id/fpsSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Bitrate"
            android:textColor="#52606D" />
        <Spinner
            android:id="@+id/bitrateSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cámara"
            android:textColor="#52606D" />
        <Spinner
            android:id="@+id/cameraSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/audioSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="false"
            android:text="Transmitir audio del micrófono (opcional)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Los cambios de resolución, FPS, bitrate y cámara se aplican al reiniciar la transmisión. 60 FPS depende del hardware del teléfono."
            android:textColor="#52606D"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Conecta el teléfono y el reproductor (PC/Android) a la misma red Wi-Fi. En VLC: Medio → Abrir ubicación de red."
            android:textColor="#52606D"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
